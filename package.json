{
  "name": "building-data-analysis",
  "private": false,
  "version": "1.1.0",
  "type": "module",
  "description": "A powerful web application for analyzing building data from OpenStreetMap and other sources. Draw polygons on a map to fetch comprehensive building information including heights, areas, and energy classifications.",
  "keywords": [
    "building-analysis",
    "openstreetmap",
    "geospatial",
    "react",
    "fastapi",
    "mapping",
    "data-visualization",
    "gis",
    "urban-planning",
    "real-estate"
  ],
  "author": {
    "name": "Building Data Analysis Team",
    "email": "contact@buildingdataanalysis.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/building-data-analysis.git"
  },
  "homepage": "https://github.com/yourusername/building-data-analysis#readme",
  "bugs": {
    "url": "https://github.com/yourusername/building-data-analysis/issues"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "lint": "node ./node_modules/eslint/bin/eslint.js . --report-unused-disable-directives --max-warnings 0",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node ./node_modules/vitest/vitest.mjs",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "start": "node ./node_modules/vite/bin/vite.js preview"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "@turf/turf": "^6.5.0",
    "axios": "^1.6.2",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "osmtogeojson": "^3.0.0-beta.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "react-leaflet-draw": "^0.20.6",
    "three": "^0.177.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.8"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
